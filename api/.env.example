# ============================================================
#  Creaty Site — variables de entorno de la API
#
#  Copia este archivo como .env y rellena los valores:
#      cp .env.example .env
#
#  El archivo .env esta en .gitignore: NUNCA se sube al repositorio.
#  Este .env.example SI se sube, para que cualquiera sepa que necesita.
# ============================================================

# ---------- Servidor ----------
PORT=8787
HOST=127.0.0.1

# ---------- Base de datos (MySQL / MariaDB) ----------
# Usuario de la app. Recomendado: usuario dedicado con permisos minimos
# (solo SELECT, INSERT, UPDATE sobre su propia base). Nada de root.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=creaty_api
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=creaty_site

# ---------- Seguridad de la API ----------
# Origenes autorizados a llamar la API (CORS), separados por coma.
# Para desarrollo local: http://localhost:4321
# Para produccion:    https://site.creaty.fun
ALLOWED_ORIGINS=http://localhost:4321,https://site.creaty.fun

# Token para consultar y gestionar los mensajes (GET /api/contact,
# PATCH /api/contact/:id/estado). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=cambia-este-token-de-administracion

# ---------- Rate limit ----------
# Ventana y maximo de envios por IP. El limite se persiste en MySQL,
# asi que sobrevive reinicios y sirve con varias instancias.
RATE_WINDOW_MS=900000
RATE_MAX=5

# ---------- SMTP (notificacion de mensajes nuevos) ----------
# Gmail: activar verificacion en 2 pasos y generar una "contrasena de
# aplicacion" en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
MAIL_FROM=tu-cuenta@gmail.com
MAIL_TO=tu-cuenta@gmail.com

# ---------- reCAPTCHA v3 ----------
# Claves desde https://www.google.com/recaptcha/admin
# El SITE_KEY es publico y va en el frontend (src/pages/contactanos.astro).
# El SECRET solo vive aqui: nunca en el frontend ni en el repositorio.
RECAPTCHA_SECRET=cambia-este-secret-de-recaptcha

# Umbral de score para aceptar un envio (0.0 = bot, 1.0 = humano).
# Google recomienda 0.5 como punto de corte razonable.
RECAPTCHA_MIN_SCORE=0.5

# ---------- Cloudflare (solo para el tunnel de preview) ----------
# El token del tunnel lo usa ~/.creaty-preview/tunnel.token, fuera del repo.
# Si trabajas con un tunnel propio, ajustalo con:
#   TOKEN_FILE=~/.creaty-preview/tunnel.token ./scripts/stack.sh start
# CLOUDFLARE_ACCOUNT_ID=tu-account-id
# CLOUDFLARE_TUNNEL_ID=tu-tunnel-id
