---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const servicios = [
  {
    icon: "code" as const,
    title: "Sitios web que venden",
    text: "Landing pages, sitios corporativos y e‑commerce rápidos, accesibles y optimizados para SEO desde el día uno.",
  },
  {
    icon: "server" as const,
    title: "VPS e infraestructura",
    text: "Administración de servidores Linux, Docker, despliegues reproducibles, backups, monitoreo y respuesta 24/7.",
  },
  {
    icon: "cloud" as const,
    title: "Cloudflare end‑to‑end",
    text: "DNS, CDN, Workers, Pages, R2, Tunnels, WAF, Zero Trust y email routing configurados y tuneados.",
  },
  {
    icon: "shield" as const,
    title: "Hardening & ciberseguridad",
    text: "SSH seguro, firewall, fail2ban, parches, escaneos, TLS estricto, cabeceras de seguridad y respuesta a incidentes.",
  },
  {
    icon: "chart" as const,
    title: "Analítica & performance",
    text: "Core Web Vitals, Lighthouse, RUM y dashboards para que cada release mejore métricas de negocio, no solo píxeles.",
  },
  {
    icon: "wrench" as const,
    title: "Soporte & mantenimiento",
    text: "Planes mensuales con SLAs claros, soporte por WhatsApp y mejoras continuas sin dolores de cabeza.",
  },
];

const pasos = [
  { title: "Descubrimiento", text: "Entendemos tu negocio, audiencia y objetivos. Nada de propuestas genéricas." },
  { title: "Arquitectura", text: "Elegimos stack, hosting y modelo de seguridad. Diseñamos pensando en velocidad y SEO." },
  { title: "Construcción", text: "Iteraciones semanales con demos reales. Tú apruebas, nosotros afinamos." },
  { title: "Lanzamiento & cuidado", text: "Despliegue, monitoreo, backups y soporte continuo desde el primer día." },
];

const testimonios = [
  {
    quote:
      "En tres semanas pasamos de una página en WordPress que tardaba 6 s a un sitio que carga en 800 ms. Las ventas online subieron 38% en el primer mes.",
    name: "Carolina M.",
    role: "Fundadora · Tienda de café de especialidad",
    initials: "CM",
  },
  {
    quote:
      "Creaty Site nos migró el VPS completo a Cloudflare + Workers sin downtime. Ahora dormimos tranquilos: monitoreo, WAF y backups funcionan como reloj.",
    name: "Andrés P.",
    role: "CTO · SaaS de facturación",
    initials: "AP",
  },
  {
    quote:
      "Necesitábamos alguien que entendiera de servidores Y de sitios. El equipo nos hizo hardening, configuró el firewall y rediseñó el sitio en el mismo sprint.",
    name: "Laura G.",
    role: "Directora · Clínica odontológica",
    initials: "LG",
  },
];
---

<BaseLayout
  title="Creaty Site — Desarrollo web rápido, infraestructura y seguridad"
  description="Agencia en Copacabana, Antioquia. Sitios web ultrarrápidos, administración de VPS, Cloudflare, hardening y ciberseguridad para pequeños y medianos negocios."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="eyebrow">Agencia en Copacabana · Antioquia</span>
        <h1>
          Sitios web <span class="gradient-text">ultrarrápidos</span>
          y operaciones digitales que no se caen.
        </h1>
        <p class="lead">
          Diseñamos, construimos y aseguramos la presencia digital de pequeños y medianos
          negocios en Colombia. Web, servidores, Cloudflare y ciberseguridad — todo en
          un mismo equipo.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contactanos">
            Empezar mi proyecto <Icon name="arrow-right" size={18} />
          </a>
          <a class="btn btn--ghost" href="/que-hacemos">Ver servicios</a>
        </div>

        <div class="hero__stats" role="list">
          <div role="listitem">
            <span class="stat__num">&lt;1s</span>
            <span class="stat__label">LCP promedio en nuestros sitios</span>
          </div>
          <div role="listitem">
            <span class="stat__num">100</span>
            <span class="stat__label">Lighthouse score objetivo</span>
          </div>
          <div role="listitem">
            <span class="stat__num">24/7</span>
            <span class="stat__label">Monitoreo y respuesta</span>
          </div>
        </div>
      </div>

      <aside class="hero__card" aria-label="Estado de operación en vivo">
        <div class="hero__card-glow" aria-hidden="true"></div>
        <h4>Status · Operación</h4>
        <div class="hero__row">
          <span><span class="dot"></span>CDN Cloudflare</span>
          <span style="color: var(--c-success)">Operativo</span>
        </div>
        <div class="hero__row">
          <span><span class="dot dot--accent"></span>VPS principal</span>
          <span style="color: var(--c-accent)">42 ms · estable</span>
        </div>
        <div class="hero__row">
          <span><span class="dot"></span>WAF / DDoS</span>
          <span style="color: var(--c-success)">Bloqueando</span>
        </div>
        <div class="hero__row">
          <span><span class="dot dot--warn"></span>Backups</span>
          <span style="color: var(--c-warning)">Hoy 03:00</span>
        </div>
        <div class="hero__row">
          <span><span class="dot"></span>SSL / TLS</span>
          <span style="color: var(--c-success)">A+ · TLS 1.3</span>
        </div>
      </aside>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section section--alt" id="servicios">
    <div class="container">
      <header class="section__head">
        <span class="eyebrow">Lo que hacemos</span>
        <h2>Un solo equipo para tu <span class="gradient-text">stack completo</span></h2>
        <p class="lead">
          No subcontratamos nada. Diseño, desarrollo, infraestructura y seguridad con
          un único punto de contacto que entiende el negocio.
        </p>
      </header>

      <div class="grid-3">
        {
          servicios.map((s) => (
            <article class="card card--feature">
              <div class="card__icon">
                <Icon name={s.icon} />
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="section">
    <div class="container">
      <header class="section__head">
        <span class="eyebrow">Cómo trabajamos</span>
        <h2>Un proceso <span class="gradient-text">transparente</span> de principio a fin</h2>
        <p class="lead">
          Cuatro fases, comunicación constante y resultados medibles en cada sprint.
        </p>
      </header>

      <div class="steps">
        {
          pasos.map((p) => (
            <article class="step">
              <h4>{p.title}</h4>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS -->
  <section class="section section--alt">
    <div class="container">
      <header class="section__head section__head--center">
        <span class="eyebrow">Clientes</span>
        <h2>Resultados que se <span class="gradient-text">miden</span></h2>
      </header>

      <div class="grid-3">
        {
          testimonios.map((t) => (
            <article class="testimonial">
              <p class="testimonial__quote">“{t.quote}”</p>
              <div class="testimonial__author">
                <div class="testimonial__avatar">{t.initials}</div>
                <div>
                  <div class="testimonial__name">{t.name}</div>
                  <div class="testimonial__role">{t.role}</div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-strip">
        <h2 class="mb-0">¿Listo para un sitio que <span class="gradient-text">sí carga</span>?</h2>
        <p class="lead" style="margin-inline:auto; margin-top:0.75rem;">
          Cuéntanos qué tienes en mente. Respondemos en menos de 24 horas con una
          propuesta honesta y un precio cerrado.
        </p>
        <div class="hero__actions" style="justify-content:center;">
          <a class="btn btn--primary" href="/contactanos">
            Escribirnos <Icon name="arrow-right" size={18} />
          </a>
          <a class="btn btn--ghost" href="/blog">Leer el blog</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
